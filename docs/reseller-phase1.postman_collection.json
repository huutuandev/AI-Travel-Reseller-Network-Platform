{
  "info": {
    "name": "Reseller API — Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Three read-only endpoints. Use an existing ACTIVE reseller account and its Bearer access token. Run List before Detail to capture a currently visible campaignId. No business data is created."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "campaignId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Campaign filters",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reseller/campaign-filters"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Categories and destinations are distinct', () => { for (const key of ['categories', 'destinations']) { const codes = body.data[key].map(x => x.code); pm.expect(new Set(codes).size).to.eql(codes.length); } });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Campaign list",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reseller/campaigns?page=0&size=20&sort=createdAt,desc",
        "description": "Optional: q, category, destination, commissionType, minCommissionPercent, participationStatus. minCommissionPercent excludes FIXED_AMOUNT; combining both returns 400."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Page envelope', () => pm.expect(body.data.content).to.be.an('array'));",
              "pm.collectionVariables.set('campaignId', body.data.content.length ? body.data.content[0].id : '');",
              "if (!body.data.content.length) console.log('No eligible campaigns. Detail requires an existing visible campaign ID.');"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Campaign detail",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reseller/campaigns/{{campaignId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Exact requested UUID', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('campaignId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Invalid UUID returns 400",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reseller/campaigns/not-a-uuid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Conflicting commission filter returns 400",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reseller/campaigns?commissionType=FIXED_AMOUNT&minCommissionPercent=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
