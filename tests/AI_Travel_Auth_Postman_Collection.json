{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-1234567890ab",
		"name": "AI Travel - Auth APIs Test Suite",
		"description": "Bộ Collection kiểm thử toàn bộ Authentication APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Đăng ký & Kích hoạt (Registration)",
			"item": [
				{
					"name": "1.1 Đăng ký tài khoản (Register)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Tự động sinh email ngẫu nhiên để không bao giờ bị trùng",
									"const randomEmail = 'tester_' + Date.now() + '@example.com';",
									"pm.collectionVariables.set('current_email', randomEmail);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Đăng ký thành công - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{current_email}}\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Nguyen Van Tester\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "1.2 Xác thực Email OTP (Verify Email)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Xác thực OTP thành công - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{current_email}}\",\n  \"otp\": \"{{input_otp}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/verify-email",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"verify-email"
							]
						}
					}
				},
				{
					"name": "1.3 Gửi lại mã OTP (Resend Verification)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Gửi lại OTP thành công - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{current_email}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/resend-verification",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"resend-verification"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Đăng nhập & Quản lý Token (Auth & Tokens)",
			"item": [
				{
					"name": "2.1 Đăng nhập (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Đăng nhập thành công và lấy Tokens - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.success).to.eql(true);",
									"    pm.expect(json.data.accessToken).to.not.be.null;",
									"    ",
									"    // Tự động lưu Token vào biến Collection",
									"    pm.collectionVariables.set('accessToken', json.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{current_email}}\",\n  \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "2.2 Làm mới Token (Refresh Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Làm mới Token thành công - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.data.accessToken).to.not.be.null;",
									"    ",
									"    pm.collectionVariables.set('accessToken', json.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						}
					}
				},
				{
					"name": "2.3 Đăng xuất (Logout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Đăng xuất thành công - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						}
					}
				}
			]
		},
