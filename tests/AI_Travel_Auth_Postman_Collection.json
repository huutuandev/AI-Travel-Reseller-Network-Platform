				{
					"name": "3.3 Đổi mật khẩu mới (Reset Password)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Đổi mật khẩu thành công - Status 200', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword@456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/reset-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"reset-password"
							]
						}
					}
				}
			]
		}
