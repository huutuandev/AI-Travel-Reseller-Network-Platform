{
  "info": {
    "name": "Reseller API — Advanced Testing (Security, Validation, Edge Cases)",
    "description": "Bộ sưu tập kiểm thử API chuyên sâu cho AI Travel Reseller Network Platform phục vụ học kỳ doanh nghiệp.\nBao gồm 3 nhóm: Security (Bảo mật & RBAC), Data Validation (Xác thực dữ liệu) và Edge Cases (Trường hợp biên).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "resellerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "campaignId",
      "value": "50000000-0000-0000-0000-000000000001"
    }
  ],
  "item": [
    {
      "name": "00 - Authentication Setup",
      "item": [
        {
          "name": "0.1 - Login as Reseller (reseller1@test.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Reseller HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Has access token', function () {",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('resellerToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reseller1@test.com\",\n  \"password\": \"Reseller@123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "0.2 - Login as Admin (admin@test.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Admin HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Has access token', function () {",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('adminToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "01 - Security Testing (Bảo mật & Phân quyền)",
      "item": [
        {
          "name": "SEC-01: Gọi API bảo mật KHÔNG có Token (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chặn truy cập không xác thực: HTTP 401 hoặc 403', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/reseller/campaigns"
          }
        },
        {
          "name": "SEC-02: Gọi API với Token giả mạo (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chặn Token giả mạo: HTTP 401 hoặc 403', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid.jwt.token.signature.fake",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns"
          }
        },
        {
          "name": "SEC-03: RBAC - Reseller gọi API của Admin (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reseller bị chặn khỏi Admin API: HTTP 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/tenants"
          }
        },
        {
          "name": "SEC-04: RBAC - Admin gọi API của Reseller (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin bị chặn khỏi Reseller API: HTTP 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns"
          }
        },
        {
          "name": "SEC-05: SQL Injection Payload trong search query (Expect không 500)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Không sập server (500) khi bị SQL Injection payload', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns?q=%27%20OR%201%3D1%3B%20DROP%20TABLE%20users%3B%20--"
          }
        }
      ]
    },
    {
      "name": "02 - Data Validation (Xác thực dữ liệu)",
      "item": [
        {
          "name": "VAL-01: Sai định dạng UUID trên URL (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('UUID sai định dạng: HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns/not-a-valid-uuid"
          }
        },
        {
          "name": "VAL-02: Body rỗng khi Login (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Body rỗng bị từ chối: HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "VAL-03: Email sai định dạng khi Login (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Email sai quy cách: HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email-format\",\n  \"password\": \"Reseller@123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "VAL-04: Mật khẩu rỗng khi Login (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mật khẩu rỗng: HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reseller1@test.com\",\n  \"password\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "VAL-05: Xung đột tham số FIXED_AMOUNT và minCommissionPercent (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Xung đột tham số bị từ chối: HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns?commissionType=FIXED_AMOUNT&minCommissionPercent=10"
          }
        }
      ]
    },
    {
      "name": "03 - Edge Cases & Boundaries (Trường hợp biên)",
      "item": [
        {
          "name": "EDG-01: UUID đúng cú pháp nhưng KHÔNG tồn tại (Expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ID không tồn tại: HTTP 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns/00000000-0000-0000-0000-000000000099"
          }
        },
        {
          "name": "SRS-01: Lấy danh sách Campaign Marketplace (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns"
          }
        },
        {
          "name": "SRS-02: Xem chi tiết Campaign hợp lệ (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns/{{campaignId}}"
          }
        },
        {
          "name": "SRS-04: Lấy danh sách chiến dịch đã đăng ký My Applications (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{resellerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reseller/campaigns/applications"
          }
        }
      ]
    }
  ]
}
